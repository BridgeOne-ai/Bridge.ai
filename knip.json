{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "core": { "entry": ["src/index.ts", "src/cli.ts"] },
    "extension": {
      "entry": [
        "src/background/service-worker.ts",
        "src/content/{gemini,chatgpt,session-only}.ts",
        "src/offscreen/offscreen.ts",
        "src/model/worker.ts",
        "src/popup/popup.ts",
